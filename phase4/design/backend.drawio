        <mxCell id="f3c0" value="&lt;p style=&quot;margin:0;line-height:14px;&quot;&gt;&lt;b&gt;MasterFileReader&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px;&quot;&gt;(Figure 6)&lt;/span&gt;&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Courier New;fontSize=11;strokeColor=#555555;fillColor=#ffffff;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1">
