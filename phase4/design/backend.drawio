          <mxGeometry x="898" y="40" width="220" height="52" as="geometry" />
        </mxCell>
        <mxCell id="f3c3" value="&lt;p style=&quot;margin:0;text-align:center;line-height:16px;&quot;&gt;«dataclass»&lt;br&gt;&lt;b&gt;FileSet&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;margin:3px 0;&quot;&gt;&lt;p style=&quot;margin:0 0 0 4px;line-height:14px;&quot;&gt;+ old_users : str&lt;br&gt;+ old_games : str&lt;br&gt;+ old_collection : str&lt;br&gt;+ merged_transactions : str&lt;br&gt;+ new_users : str&lt;br&gt;+ new_games : str&lt;br&gt;+ new_collection : str&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;margin:3px 0;&quot;&gt;&lt;p style=&quot;margin:0 0 0 4px;line-height:14px;&quot;&gt;&amp;nbsp;&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Courier New;fontSize=11;strokeColor=#555555;fillColor=#dae8fc;align=left;verticalAlign=top;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="102" y="202" width="206" height="174" as="geometry" />
        </mxCell>
        <mxCell id="f3c4" value="&lt;p style=&quot;margin:0;text-align:center;line-height:16px;&quot;&gt;&lt;b&gt;BackEnd&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;margin:3px 0;&quot;&gt;&lt;p style=&quot;margin:0 0 0 4px;line-height:14px;&quot;&gt;- _files : FileSet&lt;br&gt;- _error_log : ErrorLog&lt;br&gt;- _master_reader : MasterFileReader&lt;br&gt;- _transaction_reader : TransactionFileReader&lt;br&gt;- _master_writer : MasterFileWriter&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;margin:3px 0;&quot;&gt;&lt;p style=&quot;margin:0 0 0 4px;line-height:14px;&quot;&gt;+ __init__(files : FileSet, error_log :&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ErrorLog)&lt;br&gt;+ run() : int&lt;br&gt;- _load_state() : SystemState&lt;br&gt;- _apply_all(transactions : list[Transaction],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;state : SystemState) : None&lt;br&gt;- _write_state(state : SystemState) : None&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Courier New;fontSize=11;strokeColor=#555555;fillColor=#dae8fc;align=left;verticalAlign=top;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="441" y="182" width="331" height="214" as="geometry" />
        </mxCell>
        <mxCell id="f3c5" value="&lt;p style=&quot;margin:0;text-align:center;line-height:16px;&quot;&gt;&lt;b&gt;ErrorLog&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;margin:3px 0;&quot;&gt;&lt;p style=&quot;margin:0 0 0 4px;line-height:14px;&quot;&gt;+ FAILED_CONSTRAINT : str = 'Failed&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;constraint'&lt;br&gt;+ FATAL : str = 'Fatal input error'&lt;br&gt;- _count : int&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;margin:3px 0;&quot;&gt;&lt;p style=&quot;margin:0 0 0 4px;line-height:14px;&quot;&gt;+ __init__()&lt;br&gt;+ failed_constraint(description : str, record&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;: str) : None&lt;br&gt;+ fatal(description : str, file_name : str) :&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;None&lt;br&gt;+ count() : int&lt;/p&gt;" style="html=1;whiteSpace=wrap;fontFamily=Courier New;fontSize=11;strokeColor=#555555;fillColor=#f5f5f5;align=left;verticalAlign=top;overflow=fill;" vertex="1" parent="1">
