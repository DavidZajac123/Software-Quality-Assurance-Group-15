        </mxCell>
        <mxCell id="f1be" value="&lt;b&gt;Back End&lt;/b&gt; (backend.py and the control package)&lt;br&gt;&lt;br&gt;BackEnd.run performs one batch:&lt;br&gt;&lt;br&gt;1. MasterFileReader reads the three old master files into a SystemState.&lt;br&gt;&lt;br&gt;2. TransactionFileReader reads the merged daily file into Transaction objects.&lt;br&gt;&lt;br&gt;3. Each Transaction validates itself, then applies itself to the SystemState.&lt;br&gt;&lt;br&gt;4. MasterFileWriter writes the three new master files.&lt;br&gt;&lt;br&gt;ErrorLog prints every ERROR line." style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;strokeColor=#555555;fillColor=#ffe6cc;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="560" y="130" width="420" height="450" as="geometry" />
        </mxCell>
        <mxCell id="f1e0" value="7 file names" style="endArrow=block;endSize=8;endFill=1;html=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="f1cmd" target="f1be">
