          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="f1ei3" value="MasterFileReader" style="endArrow=block;endSize=8;endFill=1;html=1;strokeColor=#333333;fontSize=11;labelBackgroundColor=#ffffff;exitX=1.0000;exitY=0.5000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.6333;entryDx=0;entryDy=0;" edge="1" parent="1" source="f1i3" target="f1be">
